    "call": {"type": "object","additionalProperties": false,"required": ["sequence","kind","source_path","source_line","column","consumer_module","target_module","name","arity","target_proof_id","current_version","target_loaded_md5","genuine_case","framework_sha256"],"properties": {"sequence": {"type": "integer","minimum": 1},"kind": {"enum": ["remote_macro","imported_macro","remote_function","imported_function"]},"source_path": {"$ref": "#/$defs/path"},"source_line": {"type": "integer","minimum": 1},"column": {"type": ["integer","null"],"minimum": 1},"consumer_module": {"type": "string","minLength": 1},"target_module": {"type": "string","minLength": 1},"name": {"enum": ["__using__","test","describe","setup","setup_all"]},"arity": {"type": "integer","minimum": 0},"target_proof_id": {"anyOf": [{"$ref": "#/$defs/sha256"},{"type": "null"}]},"current_version": {"type": "boolean"},"target_loaded_md5": {"anyOf": [{"$ref": "#/$defs/md5"},{"type": "null"}]},"genuine_case": {"type": "boolean"},"framework_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"},{"type": "null"}]}}},
    "registered": {"type": "object","additionalProperties": false,"required": ["runtime_case_id","source_path","source_line","module","name","consumer_proof_id","tags"],"properties": {"runtime_case_id": {"$ref": "#/$defs/sha256"},"source_path": {"$ref": "#/$defs/path"},"source_line": {"type": "integer","minimum": 1},"module": {"type": "string","minLength": 1},"name": {"type": "string","minLength": 1},"consumer_proof_id": {"anyOf": [{"$ref": "#/$defs/sha256"},{"type": "null"}]},"tags": {"type": "object"}}},
    "origin": {"type": "object","additionalProperties": false,"required": ["runtime_case_id","source_declaration_id","source_path","source_line","source_sha256","macro_module","macro_definition_line","consumer_module","registration_path","registration_line","registration_sha256","name","compiled_quote_sha256","source_quote_sha256","compiled_module_sha256","macro_proof_id","consumer_proof_id","use_sequence","origin_rule"],"properties": {"runtime_case_id": {"$ref": "#/$defs/sha256"},"source_declaration_id": {"type": "string","pattern": "^[0-9a-f]{16}$"},"source_path": {"$ref": "#/$defs/path"},"source_line": {"type": "integer","minimum": 1},"source_sha256": {"$ref": "#/$defs/sha256"},"macro_module": {"type": "string","minLength": 1},"macro_definition_line": {"type": "integer","minimum": 1},"consumer_module": {"type": "string","minLength": 1},"registration_path": {"$ref": "#/$defs/path"},"registration_line": {"type": "integer","minimum": 1},"registration_sha256": {"$ref": "#/$defs/sha256"},"name": {"type": "string","minLength": 1},"compiled_quote_sha256": {"$ref": "#/$defs/sha256"},"source_quote_sha256": {"$ref": "#/$defs/sha256"},"compiled_module_sha256": {"$ref": "#/$defs/sha256"},"macro_proof_id": {"$ref": "#/$defs/sha256"},"consumer_proof_id": {"$ref": "#/$defs/sha256"},"use_sequence": {"type": "integer","minimum": 1},"origin_rule": {"const": "compiler-constant-using-v1"}}},
    "limits": {"type": "object","additionalProperties": false,"required": ["content_bytes","aggregate_content_bytes","capture_metadata_bytes","metadata_bytes","module_versions","calls","runtime_cases","stdout_bytes","stderr_bytes","verifier_deadline_ms"],"properties": {"content_bytes": {"const": 16777216},"aggregate_content_bytes": {"const": 268435456},"capture_metadata_bytes": {"const": 67108864},"metadata_bytes": {"const": 67108864},"module_versions": {"const": 10000},"calls": {"const": 1000000},"runtime_cases": {"const": 100000},"stdout_bytes": {"const": 1048576},"stderr_bytes": {"const": 1048576},"verifier_deadline_ms": {"const": 60000}}}
